# Скопируйте в .env.local и заполните. .env.local в git НЕ попадает (см. .gitignore).

# Адрес вашего аккаунта amoCRM — ровно так, как он открывается в браузере.
# Пример: https://mycompany.amocrm.ru
AMO_BASE_URL=

# Долгоживущий токен интеграции: amoCRM -> Настройки -> Интеграции ->
# ваша интеграция -> Ключи и доступы -> Токен долгосрочного действия.
AMO_ACCESS_TOKEN=

# Необязательно: куда класть сделку. Не заданы — amoCRM положит в воронку по умолчанию.
AMO_PIPELINE_ID=
AMO_STATUS_ID=
AMO_RESPONSIBLE_USER_ID=

# Название сделки в amoCRM (одинаковое для всех заявок с лендинга).
AMO_LEAD_NAME=Заявка из сайта на мини апп приложение

# Тег, по которому в CRM видно заявки с этого лендинга.
AMO_LEAD_TAG=Сайт MoySkladShop
